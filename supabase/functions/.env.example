# Exact origins, no wildcard and no trailing slash. Preview URLs must be added explicitly.
WINMIX_ALLOWED_ORIGINS=http://localhost:5173,https://YOUR_APP_HOST
# Hosted Supabase injects SUPABASE_URL. Server key resolution:
# 1. WINMIX_SUPABASE_SECRET_KEY, 2. SUPABASE_SECRET_KEYS[WINMIX_SECRET_KEY_NAME || default],
# 3. platform-provided SUPABASE_SERVICE_ROLE_KEY.
# WINMIX_SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME
# WINMIX_SECRET_KEY_NAME=default
# Optional machine caller: exactly 64 random hex characters (32 bytes), only on your trusted server.
# WINMIX_INGEST_SECRET=
