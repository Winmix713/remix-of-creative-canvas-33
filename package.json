{
  "name": "magic-patterns-vite-template",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npx vite",
    "build": "npx vite build",
    "build:dev": "npx vite build --mode development",
    "lint": "eslint .",
    "preview": "npx vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "supabase:bootstrap": "node scripts/supabase/bootstrap.mjs",
    "supabase:verify": "node scripts/supabase/verify-connection.mjs",
    "supabase:audit": "node scripts/supabase/security-audit.mjs",
    "supabase:schema": "node scripts/supabase/schema-check.mjs",
    "supabase:parity": "node scripts/supabase/parity-check.mjs",
    "supabase:diagnose": "node scripts/supabase/diagnose.mjs",
    "supabase:ingest": "node scripts/supabase/ingest.mjs",
    "supabase:check": "node scripts/supabase/bootstrap.mjs && node scripts/supabase/schema-check.mjs && node scripts/supabase/security-audit.mjs && node scripts/supabase/parity-check.mjs",
    "analytics:extract": "node scripts/analytics/extract.mjs",
    "analytics:analyze": "node scripts/analytics/analyze.mjs",
    "analytics:run": "pnpm analytics:extract && pnpm analytics:analyze"
  },
  "dependencies": {
    "@emotion/react": "^11.13.3",
    "@supabase/supabase-js": "^2.112.4",
    "framer-motion": "^11.5.4",
    "lucide-react": "0.522.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4",
    "recharts": "^2.12.7",
    "sonner": "^2.0.1",
    "tailwind-merge": "latest",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@eslint/js": "^8.57.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^20.11.18",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitest/coverage-v8": "^5.0.1",
    "autoprefixer": "latest",
    "eslint": "^9.9.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.1",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "parquetjs-lite": "^0.8.7",
    "postcss": "latest",
    "prettier": "^3.9.6",
    "stream-chain": "^4.2.5",
    "stream-json": "^3.6.0",
    "tailwindcss": "3.4.17",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
